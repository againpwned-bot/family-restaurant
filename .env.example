# Copy to .env.local and fill in (Supabase Dashboard -> Project Settings -> API Keys).
# .env.local is git-ignored. Never commit real keys.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) - or the legacy "anon" JWT key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) - or the legacy "service_role" JWT key.
# SERVER ONLY: used by the seed script and the owner's user-management actions.
SUPABASE_SECRET_KEY=
