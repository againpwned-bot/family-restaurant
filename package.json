{
  "name": "meniul-de-acasa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve": "next build && next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:i18n": "tsx scripts/check-i18n.mts",
    "test:db": "tsx db/tests/db.test.mts",
    "check": "npm run typecheck && npm run lint && npm run check:i18n && npm run test:unit && npm run test:db",
    "seed:users": "tsx scripts/seed-users.ts",
    "seed:dishes": "tsx scripts/seed-dishes.ts",
    "seed:recipes": "tsx scripts/seed-dishes.ts --family",
    "format": "prettier --write .",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx tests/e2e/admin.e2e.mts && tsx tests/e2e/client.e2e.mts && tsx tests/e2e/push.e2e.mts",
    "icons": "tsx scripts/generate-icons.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
